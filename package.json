{
  "name": "@zenorg/opencode-orchestrator",
  "version": "0.1.0-beta.9",
  "private": false,
  "description": "Orchestrator CLI and plugin for OpenCode multi-agent workflows",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZenkakuHiragana/opencode-orchestrator.git"
  },
  "homepage": "https://github.com/ZenkakuHiragana/opencode-orchestrator",
  "bugs": "https://github.com/ZenkakuHiragana/opencode-orchestrator/issues",
  "readmeFilename": "README.npm.md",
  "license": "MIT",
  "keywords": [
    "opencode",
    "orchestrator",
    "multi-agent",
    "automation",
    "cli",
    "plugin"
  ],
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "agents",
    "commands",
    "resources",
    "docs",
    "README.npm.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "opencode-orchestrator": "dist/cli.js",
    "ococ": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:readme": "node scripts/generate-npm-readme.mjs",
    "prepublishOnly": "npm run build:readme",
    "postpublish": "git restore README.md || git checkout -- README.md || true",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,mjs,md}\"",
    "test": "vitest run",
    "lint": "eslint src/ tests/"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.3.13",
    "typescript": "^6.0.2"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^10.9.1",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.1.0",
    "prettier": "^3.8.1",
    "vitest": "^4.1.2"
  },
  "overrides": {
    "@chevrotain/cst-dts-gen": "^12.0.0",
    "@mermaid-js/mermaid-cli": {
      "puppeteer": "^24.40.0"
    }
  }
}
